generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"

  extensions = [vector]
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  name      String?
  avatarUrl String?   @map("avatar_url")
  onboarded Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  topic            String
  status           SessionStatus @default(active)
  language         String?   @map("language")
  imageUrl         String?   @map("image_url")
  evaluationReport Json?     @map("evaluation_report")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents Document[]

  @@index([userId])
  validations SessionDocumentValidation[]

  @@map("sessions")
}

model Message {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  role       MessageRole
  content    String
  mode       MessageMode?
  turnNumber Int         @map("turn_number")
  createdAt  DateTime    @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model Document {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  fileName  String          @map("file_name")
  fileUrl   String          @map("file_url")
  processed Boolean         @default(false)
  detectedTopic   String?   // LLM‑derived short topic
  topicConfidence Float?   // Confidence score (0‑1) for topic detection
  createdAt DateTime        @default(now()) @map("created_at")

  session Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunks  DocumentChunk[]

  @@index([sessionId])
  validations SessionDocumentValidation[]

  @@map("documents")

}

model DocumentChunk {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid
  content    String
  embedding  Unsupported("vector(384)")?
  metadata   Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

enum SessionStatus {
  active
  completed
  abandoned
}

enum MessageRole {
  user
  ai
}

enum MessageMode {
  understanding
  socratic
}

model SessionDocumentValidation {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  selectedTopic String   // topic chosen for the session
  primaryTopic  String   // LLM‑extracted main topic of the PDF
  coveredTopics Json?    // array of topics/concepts covered
  confidence    Float?   // confidence/relevance score (0‑1)
  coversSelected Boolean // true if selectedTopic is sufficiently covered
  evidence      String?  // brief reasoning from LLM
  createdAt     DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, documentId])
  @@map("session_document_validation")
}
